# App
APP_ENV=development
API_KEY=dev-change-me
APP_VERSION=0.1.0

# Free hosted demos (Render): set APP_ENV=production and ALLOW_FAKE_LLM=true.
# That enables FakeLLM without OpenAI spend and disables API-key gating for the SPA.
ALLOW_FAKE_LLM=false

# LLM (STRICT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_LLM_CALLS_PER_RUN=3
LLM_TEMPERATURE=0

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=asorari09/Incident-Rootcause-Copilot
GITHUB_DRY_RUN=true

# Langfuse (optional locally): set ENABLED=true and provide both keys to trace graph runs.
# Leave disabled for fully offline tests and fake evals.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# Detection
ZSCORE_THRESHOLD=3.0
ROLLING_WINDOW=30

# Docker / Render: leave false on free tiers to avoid MiniLM OOM at boot.
ENABLE_RUNBOOK_INDEX=false
